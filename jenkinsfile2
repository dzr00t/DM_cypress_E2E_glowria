pipeline {
    agent {
        docker{
            image 'cypress/included:14.5.4'
            args '--entrypoint='
        }
    }

    //parametres de choix lors du lancement du build
    parameters {
        choice(name: 'TAG', choices: ['all', '@signup', '@login' , '@achat'], description: 'Choisissez le tag à exécuter (all = tout exécuter)')
        choice(name: 'RAPPORT', choices: ['aucun', 'mochawesome', 'allure'], description: 'Choisissez le type de rapport à générer')
    }

    stages {
        stage('installation dependance') {
            steps {
                sh 'npm ci'
            }
        }

        stage('lancement de test') {
            steps {
                script {
                    // Commande de base
                    def cypressCmd = "NO_COLOR=1 npx cypress run"
                    def envParams = []

                    // 1. Gestion des tags
                    if (params.TAG != 'all') {
                        // Modifiez 'grepTags' par 'tags' si vous utilisez Cucumber au lieu de cypress-grep
                        envParams.add("grepTags=${params.TAG}") 
                    }

                    // 2. Gestion du type de rapport
                    if (params.RAPPORT == 'mochawesome') {
                        cypressCmd += " --reporter mochawesome"
                    } else if (params.RAPPORT == 'allure') {
                        // Allure s'active généralement via une variable d'environnement sous Cypress
                        envParams.add("allure=true")
                    }

                    // 3. Concaténation des variables d'environnement (Cypress prend un seul flag --env avec des virgules)
                    if (envParams.size() > 0) {
                        cypressCmd += " --env " + envParams.join(',')
                    }

                    // Exécution de la commande finale
                    echo "Exécution de la commande : ${cypressCmd}"
                    sh cypressCmd
                }
            }
        }
    }
}