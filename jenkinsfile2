pipeline{
    agent any
    parameters{
        booleanParam(name: 'isAllure', defaultValue: false, description: 'generation de rapport allure')
        booleanParam(name: 'isMochawesome', defaultValue: false, description: 'generation de rapport mochawesome')
        booleanParam(name: 'istags', defaultValue: false, description: 'executer avec ou sans tags')
        // J'utilise string ici pour que tu puisses écrire plusieurs tags séparés par des virgules
        string(name: 'Tags', defaultValue: '@signup', description: 'Ecrivez vos tags séparés par des virgules (ex: @valide, @invalide)')
    }
    stages{
        stage('global stage'){
            agent{
                docker{
                    image 'cypress/included:14.5.4'
                    args '--entrypoint='
                }
            }
            stages{
                stage('instalation dependance'){
                    steps{
                        sh 'npm ci'
                    }
                }

                stage('clean results'){
                    steps{
                        sh '''
                            echo "Suppression du cache Allure..."
                            rm -rf allure-results
                            mkdir -p allure-results
                            echo "Dossier allure-results nettoyé avec succès"
                        '''
                    }
                }
        
                stage('lancement de test'){
                    steps{  
                        script{
                            if(params.isAllure){
                                if(params.istags){
                                    // Utilisation de grepTags pour les tags sous Cypress
                                    sh"NO_COLOR=1 npx cypress run --env grepTags='${params.Tags}',allure=true"
                                }else {
                                    sh"NO_COLOR=1 npx cypress run --env allure=true"
                                }
                                stash name: 'allure-results', includes: 'allure-results/*'
                                
                            }else if(params.isMochawesome){
                                if(params.istags){
                                    sh"NO_COLOR=1 npx cypress run --env grepTags='${params.Tags}' --reporter mochawesome"
                                }else {
                                    sh"NO_COLOR=1 npx cypress run --reporter mochawesome"
                                }
                                stash name: 'mocha-results', includes: 'cypress/reports/mochawesome/*', allowEmpty: true
                            }else {
                                if(params.istags){
                                    sh"NO_COLOR=1 npx cypress run --env grepTags='${params.Tags}'"
                                }else {
                                    sh"NO_COLOR=1 npx cypress run"
                                }   
                            }
                        }
                    }
                }
            }
        }
    }
    post{
        always{
            script{
                // On génère le rapport Allure à la fin si la case était cochée
                if(params.isAllure){
                    unstash 'allure-results'
                    allure includeProperties: false,
                           jdk: '',
                           results: [[path: 'allure-results/']]
                }
                if(params.isMochawesome){
                unstash 'mocha-results'
                // archiveArtifacts va créer un lien cliquable sur la page Jenkins
                archiveArtifacts artifacts: 'cypress/reports/mochawesome/*', allowEmptyArchive: true
            }
            }
        }
    }
}